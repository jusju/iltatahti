{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iltatähti: synkronoi",
            "detail": "päivittää muuttuneen mukaan 3D-mallin, laser-SVG:t ja PDF-rakennuspiirustuksen (sync_all.py)",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": ["sync_all.py"],
            "options": {"cwd": "${workspaceFolder}"},
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": []
        },
        {
            "label": "Iltatähti: seuraa muutoksia",
            "detail": "synkronoi aina kun malli, laser-SVG, skripti, DXF tai pukin STEP muuttuu",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": ["sync_all.py", "--watch"],
            "options": {"cwd": "${workspaceFolder}"},
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Iltatähti: päivitä kaikki (pakota)",
            "detail": "3D-malli, laser-SVG:t ja rakennuspiirustus muutoksista riippumatta",
            "type": "process",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": ["sync_all.py", "--force"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        }
    ]
}
